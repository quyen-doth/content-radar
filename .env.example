# Qiita Personal Access Token (Settings → Applications)
QIITA_TOKEN=

# Google AI Studio API key (Gemini)
GEMINI_API_KEY=

# LINE Messaging API channel access token (LINE Developers Console)
LINE_CHANNEL_ACCESS_TOKEN=

# Toàn bộ nội dung file JSON của Service Account, đặt trên 1 dòng (escape xuống dòng).
# Ví dụ: {"type":"service_account","project_id":"...","private_key":"-----BEGIN...","client_email":"...iam.gserviceaccount.com",...}
GOOGLE_SA_JSON=

# ID spreadsheet
SHEET_ID=

# Tuỳ chọn: true = chạy thử, KHÔNG push LINE & KHÔNG ghi History
DRY_RUN=false
